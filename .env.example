# Copy to .env and replace the example secrets BEFORE docker compose up.
# Never commit .env.
PRESENCEIQ_ADMIN_USERNAME=admin
PRESENCEIQ_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
PRESENCEIQ_REVIEWER_USERNAME=reviewer
PRESENCEIQ_REVIEWER_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
PRESENCEIQ_INGEST_USERNAME=vision-ingest
PRESENCEIQ_INGEST_PASSWORD=REPLACE_WITH_THIRD_LONG_RANDOM_SECRET
VISION_SHARED_TOKEN=REPLACE_WITH_FOURTH_LONG_RANDOM_SECRET
MONGO_ROOT_USER=presenceiq_root
MONGO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
# Optional: replace the local MongoDB URL with a separate Atlas database URI.
# MONGO_URI=mongodb+srv://<YOUR_DB_USER>:<YOUR_PASSWORD>@<YOUR_CLUSTER>/presenceiq?retryWrites=true&w=majority
VITE_API_URL=http://localhost:8080
APP_ALLOWED_ORIGIN=http://localhost:5173
# Real person detector must be provided separately; never commit copyrighted model weights.
YOLO_MODEL_PATH=/models/best.pt
VISION_DEVICE=cpu
# For trusted RTSP cameras only, keyed by camera aliases registered in the app:
# CAMERA_STREAMS_JSON={"cam-lab-1":"rtsp://camera_user:camera_password@192.168.1.20/stream"}
CAMERA_STREAMS_JSON={}
